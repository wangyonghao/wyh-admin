{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#/components/popup/alert": [
        "../admin/src/components/popup/alert/index.ts"
      ],
      "#/components/popup/drawer": [
        "../admin/src/components/popup/drawer/index.ts"
      ],
      "#/components/popup/modal": [
        "../admin/src/components/popup/modal/index.ts"
      ],
      "#/*": [
        "./src/_env/*"
      ]
    }
  },
  "include": [
    ".vitepress/*.mts",
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "src/*.mts",
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules"
  ]
}
