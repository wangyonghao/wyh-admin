      ],
      "@vben/types": [
        "./src/components/vben/types/index.ts"
      ],
      "@vben/constants": [
        "./src/components/vben/constants/index.ts"
      ],
      "@vben/utils": [
        "./src/components/vben/utils/index.ts"
