      "@vben/styles": [
        "./src/components/vben/styles/index.ts"
      ],
      "@vben/plugins/echarts": [
        "./src/components/vben/plugins/echarts/index.ts"
      ],
      "@vben/plugins/tiptap": [
        "./src/components/vben/plugins/tiptap/index.ts"
      ],
      "@vben/plugins/vxe-table": [
        "./src/components/vben/plugins/vxe-table/index.ts"
