      "@vben/plugins/motion": [
        "./src/components/vben/plugins/motion/index.ts"
      ],
      "@vben/plugins": [
        "./src/components/vben/plugins/index.ts"
      ],
      "@vben/common-ui/es/tippy": [
        "./src/components/vben/common-ui/components/tippy/index.ts"
