  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/components/vben/types/global.d.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.vue",
    "../../packages/ui-patterns/src/**/*.ts",
    "../../packages/ui-patterns/src/**/*.vue"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.test.ts",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
