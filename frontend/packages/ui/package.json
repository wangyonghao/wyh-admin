{
  "name": "@wyh/ui",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "exports": {
    "./badge/variant": {
      "types": "./src/badge/variant.ts",
      "default": "./src/badge/variant.ts"
    },
    "./checkbox/group": {
      "types": "./src/checkbox/group.ts",
      "default": "./src/checkbox/group.ts"
    },
    "./date-picker/date-value": {
      "types": "./src/date-picker/date-value.ts",
      "default": "./src/date-picker/date-value.ts"
    },
    "./*": {
      "types": "./src/*/index.ts",
      "default": "./src/*/index.ts"
    }
  },
  "dependencies": {
    "@vueuse/core": "catalog:",
    "@wyh/composables": "workspace:*",
    "@wyh/icons": "workspace:*",
    "@wyh/shared": "workspace:*",
    "@wyh/typings": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-vue-next": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "catalog:"
  }
}
