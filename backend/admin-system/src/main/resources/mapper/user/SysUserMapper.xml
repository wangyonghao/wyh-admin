<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="top.wyhao.system.admin.infrastructure.persistence.mapper.SysUserMapper">

    <sql id="selectUser">
        SELECT
            t1.id,
            t1.create_user,
            t1.create_time,
            t1.update_user,
            t1.update_time,
            t1.username,
            t1.display_name,
            t1.password,
            t1.gender,
            t1.email,
            t1.phone,
            t1.avatar,
            t1.description,
            t1.status,
            t1.is_builtin,
            t1.pwd_update_time,
            t1.department_id,
            t2.name AS departmentName
        FROM sys_user AS t1
        LEFT JOIN sys_department AS t2 ON t2.id = t1.department_id
    </sql>

    <select id="selectUserPage" resultType="top.wyhao.system.admin.app.dto.UserResult">
        <include refid="selectUser" />
        ${ew.customSqlSegment}
    </select>

    <select id="selectUserList" resultType="top.wyhao.system.admin.app.dto.UserDetail">
        <include refid="selectUser" />
        ${ew.customSqlSegment}
    </select>
</mapper>