<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="top.wyhao.system.admin.infrastructure.persistence.mapper.SysUserSocialMapper">
    <select id="selectBySourceAndOpenId" resultType="top.wyhao.system.admin.infrastructure.persistence.dataobject.SysUserSocialDO">
      SELECT t1.*
        FROM sys_user_social AS t1
            LEFT JOIN sys_user AS t2 ON t2.id = t1.user_id
        WHERE t1.source = #{provider} AND t1.open_id = #{openId}
    </select>
</mapper>